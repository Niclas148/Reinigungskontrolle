rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function angemeldet() { return request.auth != null; }
    function profilPfad() { return /databases/$(database)/documents/benutzer/$(request.auth.uid); }
    function profil() { return get(profilPfad()).data; }
    function aktiv() { return angemeldet() && exists(profilPfad()) && profil().aktiv == true; }
    function leitung() { return aktiv() && profil().rolle == 'leitung'; }

    // Hausmeister darf nur für zugeordnete Einrichtungen erfassen
    // (leere Liste = alle Einrichtungen)
    function darfEinrichtung(einrichtungId) {
      return profil().einrichtungen.size() == 0 || einrichtungId in profil().einrichtungen;
    }

    match /benutzer/{uid} {
      allow read: if angemeldet() && (request.auth.uid == uid || leitung());
      allow write: if leitung();
      // Nach dem ersten Login darf jeder nur seinen eigenen Merker "passwortAendern" auf false setzen
      allow update: if angemeldet() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['passwortAendern'])
        && request.resource.data.passwortAendern == false;
    }

    match /einrichtungen/{id} {
      allow read: if aktiv();
      allow write: if leitung();
    }

    match /kontrollen/{id} {
      allow read: if aktiv();

      // Erstmeldung: einmal pro Einrichtung und Tag, danach gesperrt
      allow create: if leitung() || (
        aktiv()
        && request.resource.data.erfasstVon == request.auth.uid
        && request.resource.data.status in ['ok', 'mangel']
        && id == request.resource.data.datum + '_' + request.resource.data.einrichtungId
        && darfEinrichtung(request.resource.data.einrichtungId)
        && request.resource.data.bemerkung.size() <= 500
        && request.resource.data.get('nachtraege', []).size() == 0
      );

      // Hausmeister dürfen nur einen Nachtrag anhängen (nichts ändern oder entfernen).
      // Ein nachgemeldeter Mangel darf den Status auf "mangel" setzen, nie zurück.
      allow update: if leitung() || (
        aktiv()
        && darfEinrichtung(resource.data.einrichtungId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nachtraege', 'status'])
        && (request.resource.data.status == resource.data.status || request.resource.data.status == 'mangel')
        && request.resource.data.nachtraege.size() == resource.data.get('nachtraege', []).size() + 1
        && request.resource.data.nachtraege.hasAll(resource.data.get('nachtraege', []))
        && request.resource.data.nachtraege[request.resource.data.nachtraege.size() - 1].von == request.auth.uid
        && request.resource.data.nachtraege[request.resource.data.nachtraege.size() - 1].get('text', '').size() <= 500
      );

      // Löschen nur durch die Leitung (Notfall)
      allow delete: if leitung();
    }
  }
}
